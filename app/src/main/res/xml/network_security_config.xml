<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTP biasa (cleartext) hanya diizinkan ke 10.0.2.2, yaitu alamat laptop dari emulator,
    tempat payment-server berjalan saat demo. Semua alamat lain wajib HTTPS
    (termasuk halaman Midtrans Snap di WebView).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
